{
  "name": "stetwise",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Stetwise by Ouroboros: safe, reversible Excel and Word edits for AI assistants",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run --maxWorkers=1 --hookTimeout=60000",
    "test:engine": "PYTHONPATH=engine:engine/tests python3 -m pytest -q engine/tests",
    "benchmark": "PYTHONPATH=engine:engine/tests python3 scripts/benchmark.py",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
