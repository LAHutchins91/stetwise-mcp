# Copy to .env. Do not commit .env. No prices belong in this file.
# Stripe price IDs are created in the Stripe dashboard. The server never prints an amount.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing Stripe objects. Checkout only references these. Do not create products or prices.
STRIPE_PRODUCT_ID=prod_VQ12q90uKDcoto
STRIPE_PRICE_MONTHLY=price_1UPB0453QnCs3zydekVagtYa
STRIPE_PRICE_YEARLY=price_1UPB0953QnCs3zydvFaCDgDw
APP_BASE_URL=http://localhost:3000
ENGINE_URL=
ENGINE_HMAC_SECRET=
# local = STETWISE_DATA_DIR. Leave unset on the host once supabase/schema.sql has been applied.
STETWISE_STORE=local
STETWISE_DATA_DIR=.data
STETWISE_SIGNING_SECRET=
STETWISE_PURGE_SECRET=
STETWISE_DEV_AUTH=
STETWISE_DEV_TOKEN=
STETWISE_PYTHON=python3
STETWISE_HTTP_ONLY=
# Public origin of the Node process that accepts PUT/GET file bodies. Defaults to APP_BASE_URL.
STETWISE_FILE_BASE_URL=
# Set to 0 on Vercel. Leave empty on the Node container.
STETWISE_ACCEPT_UPLOADS=
OPENAI_APPS_CHALLENGE=
PORT=3000

# Monthly caps. Defaults are the product limits. Past a cap the call is blocked.
# STETWISE_CAP_PRO_EDITS=1000
# STETWISE_CAP_PRO_FILES=250
# STETWISE_CAP_PRO_RECALCS=100
# STETWISE_CAP_PRO_PROPOSALS=2000
# STETWISE_CAP_PRO_MAX_BYTES=26214400
# STETWISE_CAP_TRIAL_EDITS=100
# STETWISE_CAP_TRIAL_FILES=25
# STETWISE_CAP_TRIAL_RECALCS=20
# STETWISE_CAP_TRIAL_PROPOSALS=200
# STETWISE_CAP_TRIAL_MAX_BYTES=26214400
# Each started 5 MB of a file counts as one unit. A call that would pass a cap is blocked.
# STETWISE_HEAD_CACHE_BYTES=67108864
# STETWISE_RECALC_TIMEOUT=60
